const PDFDocument = require('pdfkit');

exports.generateWSBCReport = (req, res) => {
    const incidentId = req.params.id;
    const db = req.db; // Get the pool from the request object

    const sql = 'SELECT * FROM incidents WHERE incident_id = ?';
    
    db.query(sql, [incidentId], (err, results) => {
        if (err) {
            console.error("❌ SQL Error:", err);
            return res.status(500).send("Database Error");
        }

        const incident = results[0];
        if (!incident) {
            return res.status(404).send("Incident not found");
        }

        try {
            const doc = new PDFDocument({ margin: 50 });

            // Set headers for download
            res.setHeader('Content-Type', 'application/pdf');
            res.setHeader('Content-Disposition', `attachment; filename=WorkSafeBC_Report_${incidentId}.pdf`);

            doc.pipe(res);

            // --- PDF Content ---
            doc.fontSize(18).text('SafeSight: WorkSafeBC EIIR Report', { align: 'center' });
            doc.moveDown();
            doc.fontSize(12).text(`Incident ID: #SIGHT-${incident.incident_id}`);
            doc.text(`Department: ${incident.department}`);
            doc.text(`Work Area: ${incident.work_area}`);
            doc.text(`Date/Time: ${new Date(incident.incident_datetime).toLocaleString()}`);
            doc.moveDown();
            
            doc.fontSize(14).text('Incident Description:', { underline: true });
            doc.fontSize(11).text(incident.description || "No description provided.");
            
            doc.moveDown();
            doc.text(`Incident Type: ${incident.incident_type}`);
            doc.text(`Severity: ${incident.severity}`);
            doc.text(`PPE Worn: ${incident.ppe_worn ? 'Yes' : 'No'}`);
            doc.text(`Hospitalized: ${incident.hospitalized ? 'Yes' : 'No'}`);

            doc.end();
        } catch (pdfError) {
            console.error("❌ PDF Generation Error:", pdfError);
            res.status(500).send("Error generating PDF");
        }
    });
};